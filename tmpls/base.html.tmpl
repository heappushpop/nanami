<!doctype html>
<html lang="en-US">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{{block "title" .}}{{end}}</title>
        <link href="/static/app.css" rel="stylesheet" />
        <script src="/static/app.js" type="module"></script>
    </head>
    <body data-path="{{.Path}}">
        <header class="header">
            <ul class="header__links">
                <li><a class="header__link" href="/">Home</a></li>
                <li><a class="header__link" href="/config">Config</a></li>
                {{if .User}}
                    <li><a class="header__link" href="/register">Register</a></li>
                    <li><form action="/logout" method="post"><button class="button">Logout</button></form></li>
                {{else}}
                    <li><a class="header__link" href="/login">Login</a></li>
                {{end}}
            </ul>
        </header>
        <main>{{block "main" .}}{{end}}</main>
    </body>
</html>
