[Unit]
Requires=caddy-api.service xray.service
After=caddy-api.service xray.service

[Service]
Type=exec
ExecStart=/usr/local/bin/nanami
Restart=on-failure
User=nanami
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
StateDirectory=nanami
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivatePIDs=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
PrivateBPF=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
